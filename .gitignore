# ============================================================
# 根级统一 .gitignore（合并自 backend/ 与 frontend/ 子级配置并修正）
# ============================================================

# ===== Python (backend) =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
backend/.venv/
backend/venv/
backend/env/
# 依赖锁文件必须纳入版本控制（修正 backend 原 *.lock 误忽略 uv.lock）
!backend/uv.lock

# ===== Python 工具缓存与测试产物 =====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ===== 运行时数据（backend）=====
backend/data/
# ChromaDB 向量库运行时数据（含 test 目录下测试生成的实例）
**/chroma_db/
backend/sql/
backend/checkpoints.db
backend/*.db
backend/*.sqlite3
backend/test

# ===== Node.js (frontend) =====
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
frontend/auto-imports.d.ts
frontend/components.d.ts
coverage/
*.tsbuildinfo

# ===== 环境变量与密钥 =====
.env
.env.local
.env.*.local
# 注意：frontend/.env.development 与 .env.production 保留纳入版本控制（前端配置无敏感信息）

# ===== IDE / 编辑器 =====
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.txt

# ===== WorkBuddy / CodeBuddy 工具元数据 =====
.workbuddy/
.agents/
# CodeBuddy 工作区数据（仅本地保留，不纳入版本控制）
.codebuddy/

# ===== 系统 / 临时 =====
.DS_Store
Thumbs.db
nul
*.bak
*.log
*.tmp
